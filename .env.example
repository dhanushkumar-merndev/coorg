# Set this to the final HTTPS website origin before building for production.
# Vercel's production hostname is detected automatically when this is omitted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enquiry form → Google Sheet (server-only; never prefix with NEXT_PUBLIC_).
# Setup steps: integrations/google-sheets/enquiry-webhook.gs and README "Enquiry form → Google Sheet".
ENQUIRY_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
ENQUIRY_SHEET_SECRET=replace-with-a-long-random-string
